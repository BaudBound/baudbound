# Rust
/target/
# An alternate CARGO_TARGET_DIR leaves a second build tree beside the first,
# which is build output like any other and must not reach a commit.
/target-*/
**/*.rs.bk

# Node/Vite
node_modules/
.pnpm-store/
dist/
.vite/
coverage/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
/examples/

# Planning notes live outside the repositories
/plan/
/!plans/
*-PLAN.md
*_plan.md
*-plan.md

# BaudBound local runtime data
*.db
*.sqlite
*.sqlite3
*.bbs.tmp

